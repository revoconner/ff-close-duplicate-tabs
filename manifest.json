{
    "manifest_version": 3,
    "name": "FF Close Duplicate Tabs",
    "version": "1.0.0",
    "description": "Closes duplicate tabs with one click and lists what was closed.",
    "permissions": ["tabs", "storage"],
    "browser_specific_settings": {
        "gecko": {
            "id": "ffcloseduplicatetabs@revoconner",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "icons": {
        "48": "icon.png",
        "96": "icon.png"
    },
    "background": {
        "scripts": ["background.js"]
    },
    "action": {
        "default_title": "Close duplicate tabs",
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "options_ui": {
        "page": "options.html"
    }
}
